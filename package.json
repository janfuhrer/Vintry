{
	"name": "vintry",
	"version": "0.0.1",
	"description": "A slim, private wine-cellar PWA: scan a label, keep bottles, log what you drank.",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/janfuhrer/Vintry.git"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"predev": "node scripts/copy-ocr-assets.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/copy-ocr-assets.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"icons": "node scripts/icons.mjs",
		"test": "vitest run",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/run.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:ocr": "node tests/ocr/run.mjs"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.4.0",
		"@simplewebauthn/server": "^14.0.3",
		"postgres": "^4.0.0",
		"sharp": "^0.35.5",
		"zod": "^4.6.7",
		"zxing-wasm": "^3.1.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@resvg/resvg-js": "^2.6.2",
		"@simplewebauthn/browser": "^14.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tesseract.js-data/deu": "^1.0.0",
		"@tesseract.js-data/eng": "^1.0.0",
		"@tesseract.js-data/fra": "^1.0.0",
		"@types/node": "^26",
		"devalue": "^5.9.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tesseract.js": "^7.0.0",
		"topojson-client": "^3.1.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"world-atlas": "^2.0.2"
	}
}
