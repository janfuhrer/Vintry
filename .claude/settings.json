{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm audit *)",
      "Bash(npm ls *)",
      "Bash(npm outdated *)",
      "Bash(npx svelte-kit sync)",
      "Bash(npx svelte-check *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(node scripts/*)",
      "Bash(docker build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git ls-remote *)",
      "Bash(git check-ignore *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh api *)",
      "Bash(npm install *)",
      "Bash(docker run *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Edit(/.npmrc)",
      "Edit(/LICENSE)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Edit(/.claude/**)",
      "Edit(~/.claude/settings.json)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(ssh-add *)",
      "Bash(ssh-keygen *)",
      "Bash(gpg --export-secret-keys *)",
      "Bash(gpg --export-secret-subkeys *)",
      "Bash(security *)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git config --global *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm token *)",
      "Bash(npm config *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)"
    ]
  }
}
